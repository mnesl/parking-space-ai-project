# ============================================================================
# 1. LLM & EMBEDDING PROVIDER ("gemini" or "openai")
# ============================================================================
LLM_PROVIDER=gemini

# Google AI Studio Free Developer API Key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# OpenAI API Key (Optional alternative if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================================
# 2. PINECONE VECTOR DATABASE (https://app.pinecone.io/)
# ============================================================================
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=parking-knowledge-base
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Set to "true" during local testing/CI if you want in-memory vector search
# without requiring a live internet connection to Pinecone
USE_LOCAL_VECTOR_FALLBACK=false

# ============================================================================
# 3. STAGE 2 & 3: ADMIN HITL API & MCP SERVER SECURITY
# ============================================================================
ADMIN_API_KEY=secret-admin-approval-key-2026
MCP_SERVER_API_KEY=secret-mcp-writer-key-2026
ADMIN_API_BASE_URL=http://127.0.0.1:8000

